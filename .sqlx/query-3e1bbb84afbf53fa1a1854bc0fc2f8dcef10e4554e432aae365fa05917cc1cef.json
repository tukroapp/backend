  "query": "\n            UPDATE community_topic_comment c\n            SET deleted_at = NOW()\n            WHERE c.id = $1 AND c.deleted_at IS NULL\n            RETURNING\n                c.body,\n                c.author_id,\n                (SELECT up.slug FROM user_profile up WHERE up.user_id = c.author_id) AS \"slug!\"\n            ",
