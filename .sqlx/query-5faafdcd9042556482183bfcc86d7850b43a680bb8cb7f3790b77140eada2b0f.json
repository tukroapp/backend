{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        s.id,\n                        s.body,\n                        s.created_at,\n                        s.parent_id IS NOT NULL AS \"is_reply!\",\n                        s.deleted_at IS NOT NULL AS \"is_deleted!\",\n                        wall.slug AS wall_slug\n                    FROM scrap s\n                    INNER JOIN user_profile wall ON wall.user_id = s.profile_id\n                    WHERE s.author_id = $1\n                    ORDER BY s.id DESC\n                    LIMIT $2\n                    ",
