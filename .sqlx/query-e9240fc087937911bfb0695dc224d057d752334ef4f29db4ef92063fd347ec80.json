  "query": "\n            SELECT\n                ct.title,\n                ct.body,\n                ct.created_at,\n                ct.is_locked,\n                ct.deleted_at IS NOT NULL AS \"is_deleted!\",\n                c.slug AS community_slug\n            FROM community_topic ct\n            INNER JOIN community c ON c.id = ct.community_id\n            WHERE ct.id = $1\n            ",
