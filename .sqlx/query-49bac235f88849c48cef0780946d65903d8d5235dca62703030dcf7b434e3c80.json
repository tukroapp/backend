  "query": "\n        SELECT\n            au.is_email_verified,\n            up.name,\n            au.email AS \"email!: String\"\n        FROM auth_user au\n        INNER JOIN user_profile up ON up.user_id = au.id\n        WHERE au.id = $1\n        ",
