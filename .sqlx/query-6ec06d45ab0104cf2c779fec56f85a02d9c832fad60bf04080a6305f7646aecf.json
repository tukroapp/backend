  "query": "\n        SELECT s.profile_id, s.author_id, s.parent_id, up.slug AS profile_slug\n        FROM scrap s\n        INNER JOIN user_profile up ON up.user_id = s.profile_id\n        WHERE s.id = $1 AND s.deleted_at IS NULL\n        ",
