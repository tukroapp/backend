{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.id,\n            r.reason::TEXT AS \"reason!\",\n            r.status::TEXT AS \"status!\",\n            r.created_at,\n            reporter.slug AS reporter_slug\n        FROM report r\n        INNER JOIN user_profile reporter ON reporter.user_id = r.reporter_id\n        WHERE r.reported_user_id = $1 AND r.id <> $2\n        ORDER BY r.id DESC\n        LIMIT $3\n        ",
