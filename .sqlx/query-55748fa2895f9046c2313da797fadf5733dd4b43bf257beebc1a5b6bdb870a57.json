{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                cp.question,\n                cp.created_at,\n                cp.is_closed,\n                cp.closes_at,\n                cp.deleted_at IS NOT NULL AS \"is_deleted!\",\n                c.slug AS community_slug,\n                ARRAY(\n                    SELECT o.text\n                    FROM community_poll_option o\n                    WHERE o.poll_id = cp.id\n                    ORDER BY o.position\n                ) AS \"options!\"\n            FROM community_poll cp\n            INNER JOIN community c ON c.id = cp.community_id\n            WHERE cp.id = $1\n            ",
