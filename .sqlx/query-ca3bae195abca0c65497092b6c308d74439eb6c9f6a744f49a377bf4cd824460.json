{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE email_queue\n            SET scheduled_at = NOW() + ($1 || ' minutes')::INTERVAL\n            WHERE id IN (\n                SELECT id\n                FROM email_queue\n                WHERE attempts < $2\n                  AND scheduled_at <= NOW()\n                ORDER BY scheduled_at\n                LIMIT $3\n                FOR UPDATE SKIP LOCKED\n            )\n            RETURNING id, from_address, to_address, cc, bcc, subject,\n                      html_content, text_content, attempts, created_at\n            ",
