  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO notification (user_id, actor_id, kind, community_id)\n        SELECT cm.user_id, $2, $3, $1\n        FROM community_member cm\n        WHERE cm.community_id = $1\n          AND cm.role IN ('owner', 'admin')\n          AND cm.user_id <> $2\n        ",
