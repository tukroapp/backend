  "query": "\n            UPDATE community_poll p\n            SET deleted_at = NOW()\n            WHERE p.id = $1 AND p.deleted_at IS NULL\n            RETURNING\n                p.question,\n                p.author_id,\n                (SELECT up.slug FROM user_profile up WHERE up.user_id = p.author_id) AS \"slug!\"\n            ",
