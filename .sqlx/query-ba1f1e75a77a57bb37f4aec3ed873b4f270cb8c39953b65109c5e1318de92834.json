{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT action AS \"action: ModerationAction\"\n        FROM moderation_log\n        WHERE action IN ('content_removed', 'content_restored')\n          AND (scrap_id = $1 OR testimonial_id = $2 OR community_id = $3\n               OR topic_id = $4 OR comment_id = $5 OR poll_id = $6)\n        ORDER BY id DESC\n        LIMIT 1\n        ",
