{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        t.id,\n                        t.body,\n                        t.status::TEXT AS \"status!\",\n                        t.created_at,\n                        t.deleted_at IS NOT NULL AS \"is_deleted!\",\n                        target.slug AS profile_slug\n                    FROM testimonial t\n                    INNER JOIN user_profile target ON target.user_id = t.profile_id\n                    WHERE t.author_id = $1\n                    ORDER BY t.id DESC\n                    LIMIT $2\n                    ",
