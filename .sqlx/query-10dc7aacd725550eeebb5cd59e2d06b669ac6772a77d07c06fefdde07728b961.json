{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            up.user_id AS id,\n            up.slug,\n            up.name,\n            up.avatar_url,\n            up.status\n        FROM block b\n        INNER JOIN user_profile up ON up.user_id = b.blocked_id\n        WHERE b.blocker_id = $1\n          AND ($2::uuid IS NULL OR b.blocked_id < $2::uuid)\n        ORDER BY b.blocked_id DESC\n        LIMIT $3\n        ",
