  "query": "\n            UPDATE community_topic t\n            SET deleted_at = NOW()\n            WHERE t.id = $1 AND t.deleted_at IS NULL\n            RETURNING\n                t.title,\n                t.body,\n                t.author_id,\n                (SELECT up.slug FROM user_profile up WHERE up.user_id = t.author_id) AS \"slug!\"\n            ",
