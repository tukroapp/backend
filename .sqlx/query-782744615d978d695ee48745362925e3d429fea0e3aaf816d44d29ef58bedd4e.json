{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.id,\n            m.body,\n            m.created_at,\n            (m.sender_id = $1) AS \"from_me!\"\n        FROM message m\n        WHERE m.conversation_id = $2\n          AND (\n              $3::timestamptz IS NULL\n              OR (m.created_at, m.id) < ($3::timestamptz, $4::uuid)\n          )\n        ORDER BY m.created_at DESC, m.id DESC\n        LIMIT $5\n        ",
