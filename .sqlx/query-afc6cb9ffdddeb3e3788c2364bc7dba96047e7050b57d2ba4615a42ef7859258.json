{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            up.user_id AS id,\n            up.slug,\n            up.name,\n            up.avatar_url,\n            up.status\n        FROM fan\n        INNER JOIN auth_user au ON au.id = fan.fan_id AND au.status = 'active'\n        INNER JOIN user_profile up ON up.user_id = fan.fan_id\n        WHERE fan.idol_id = $1\n          AND ($2::uuid IS NULL OR fan.fan_id < $2::uuid)\n        ORDER BY fan.fan_id DESC\n        LIMIT $3\n        ",
