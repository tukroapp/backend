  "query": "\n            UPDATE user_media m\n            SET deleted_at = NOW()\n            WHERE m.id = $1 AND m.deleted_at IS NULL\n            RETURNING\n                m.caption,\n                m.user_id,\n                (SELECT up.slug FROM user_profile up WHERE up.user_id = m.user_id) AS \"slug!\"\n            ",
