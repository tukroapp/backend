{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            up.user_id AS id,\n            up.slug,\n            up.name,\n            up.avatar_url,\n            up.status\n        FROM friend f\n        INNER JOIN auth_user au ON au.id = f.friend_id AND au.status = 'active'\n        INNER JOIN user_profile up ON up.user_id = f.friend_id\n        WHERE f.user_id = $1\n          AND ($2::uuid IS NULL OR f.friend_id < $2::uuid)\n          AND (\n              $3::text IS NULL\n              OR up.name ILIKE '%' || $3 || '%'\n              OR up.slug LIKE $3 || '%'\n          )\n        ORDER BY f.friend_id DESC\n        LIMIT $4\n        ",
