{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.slug,\n            c.name,\n            c.description,\n            c.avatar_url,\n            c.is_private,\n            (\n                SELECT COUNT(*) FROM community_member cm\n                INNER JOIN auth_user au ON au.id = cm.user_id AND au.status = 'active'\n                WHERE cm.community_id = c.id\n            ) AS \"members_count!\"\n        FROM community c\n        WHERE c.deleted_at IS NULL\n          AND ($1::uuid IS NULL OR c.id < $1::uuid)\n        ORDER BY c.id DESC\n        LIMIT $2\n        ",
