  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            kind AS \"kind: MediaKind\",\n            storage_key,\n            content_type,\n            size_bytes,\n            created_at\n        FROM user_media\n        WHERE user_id = $1\n          AND ($2::media_kind IS NULL OR kind = $2)\n          AND ($3::uuid IS NULL OR id < $3::uuid)\n        ORDER BY id DESC\n        LIMIT $4\n        ",
