{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.slug,\n            c.name,\n            c.description,\n            c.avatar_url,\n            c.category AS \"category: CommunityCategory\",\n            c.is_private,\n            (\n                SELECT COUNT(*) FROM community_member m\n                INNER JOIN auth_user au ON au.id = m.user_id AND au.status = 'active'\n                WHERE m.community_id = c.id\n            ) AS \"members_count!\"\n        FROM community_member cm\n        INNER JOIN community c ON c.id = cm.community_id\n        WHERE cm.user_id = $1\n          AND c.deleted_at IS NULL\n          AND ($2::uuid IS NULL OR c.id < $2::uuid)\n          AND (\n              $4::uuid IS NULL\n              OR EXISTS (\n                  SELECT 1 FROM community_member mine\n                  WHERE mine.user_id = $4::uuid AND mine.community_id = c.id\n              )\n          )\n        ORDER BY c.id DESC\n        LIMIT $3\n        ",
