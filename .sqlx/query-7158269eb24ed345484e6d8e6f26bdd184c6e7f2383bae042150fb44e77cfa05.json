  "query": "\n            UPDATE scrap s\n            SET deleted_at = NOW()\n            WHERE s.id = $1 AND s.deleted_at IS NULL\n            RETURNING\n                s.body,\n                s.author_id,\n                (SELECT up.slug FROM user_profile up WHERE up.user_id = s.author_id) AS \"slug!\"\n            ",
