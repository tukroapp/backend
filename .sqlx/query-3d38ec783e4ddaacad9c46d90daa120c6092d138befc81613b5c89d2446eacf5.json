{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.user_id,\n            up.slug,\n            a.visibility AS \"album_visibility?: Visibility\"\n        FROM user_media m\n        INNER JOIN user_profile up ON up.user_id = m.user_id\n        LEFT JOIN album a ON a.id = m.album_id\n        WHERE m.id = $1 AND m.deleted_at IS NULL\n        ",
