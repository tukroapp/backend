{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            o.id,\n            o.position,\n            o.text,\n            COUNT(v.user_id) AS \"votes!\",\n            COALESCE(BOOL_OR(v.user_id = $2::uuid), FALSE) AS \"mine!\"\n        FROM community_poll_option o\n        LEFT JOIN community_poll_vote v ON v.option_id = o.id\n        WHERE o.poll_id = $1\n        GROUP BY o.id, o.position, o.text\n        ORDER BY o.position\n        ",
