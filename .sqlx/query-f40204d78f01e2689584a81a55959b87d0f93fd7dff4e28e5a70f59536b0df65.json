  "query": "\n            SELECT\n                m.storage_key,\n                m.kind::TEXT AS \"kind!\",\n                m.caption,\n                m.created_at,\n                m.deleted_at IS NOT NULL AS \"is_deleted!\",\n                up.slug AS owner_slug\n            FROM user_media m\n            INNER JOIN user_profile up ON up.user_id = m.user_id\n            WHERE m.id = $1\n            ",
