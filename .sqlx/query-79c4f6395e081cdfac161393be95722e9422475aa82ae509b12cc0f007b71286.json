  "query": "\n        SELECT\n            au.id,\n            au.status AS \"status: AccountStatus\",\n            au.is_superuser\n        FROM auth_user au\n        INNER JOIN user_profile up ON up.user_id = au.id\n        WHERE up.slug = $1\n        ",
