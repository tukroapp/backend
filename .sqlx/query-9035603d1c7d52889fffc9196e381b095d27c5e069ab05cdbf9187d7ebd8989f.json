{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.slug,\n            c.name,\n            c.description,\n            c.avatar_url,\n            c.is_private,\n            c.created_at,\n            c.members_count,\n            (\n                SELECT COUNT(*) FROM community_join_request r\n                WHERE r.community_id = c.id AND r.status = 'pending'\n            ) AS \"pending_requests_count!\"\n        FROM community c\n        WHERE c.id = $1\n        ",
