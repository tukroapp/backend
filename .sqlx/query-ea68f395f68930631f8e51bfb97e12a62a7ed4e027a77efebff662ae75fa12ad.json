{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                mc.body,\n                mc.created_at,\n                mc.deleted_at IS NOT NULL AS \"is_deleted!\",\n                m.id AS media_id,\n                m.storage_key,\n                up.slug AS media_owner_slug\n            FROM media_comment mc\n            INNER JOIN user_media m ON m.id = mc.media_id\n            INNER JOIN user_profile up ON up.user_id = m.user_id\n            WHERE mc.id = $1\n            ",
