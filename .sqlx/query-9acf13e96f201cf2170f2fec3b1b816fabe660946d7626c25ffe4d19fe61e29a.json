  "query": "\n            SELECT\n                s.body,\n                s.created_at,\n                s.parent_id IS NOT NULL AS \"is_reply!\",\n                s.deleted_at IS NOT NULL AS \"is_deleted!\",\n                wall.slug AS wall_slug\n            FROM scrap s\n            INNER JOIN user_profile wall ON wall.user_id = s.profile_id\n            WHERE s.id = $1\n            ",
