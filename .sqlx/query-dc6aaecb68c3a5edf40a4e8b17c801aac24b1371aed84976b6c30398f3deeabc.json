{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            up.user_id AS id,\n            up.slug,\n            up.name,\n            up.avatar_url,\n            up.status\n        FROM friend f\n        INNER JOIN auth_user au ON au.id = f.friend_id AND au.status = 'active'\n        INNER JOIN user_profile up ON up.user_id = f.friend_id\n        WHERE f.user_id = $1 AND f.top_position IS NOT NULL\n        ORDER BY f.top_position\n        ",
