# Chave secreta da aplicação. Gere uma aleatória e longa por ambiente.
SECRET_KEY="change_me"
APP_PORT=8001
APP_HOST=0.0.0.0
# URL pública do backend, usada para montar links que voltam para a API.
APP_BASE_URL=http://localhost:8001
# URL do SPA, usada nos links dos e-mails (confirmação, reset de senha).
APP_FRONTEND_URL=http://localhost:5173

DB_USERNAME=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tukro_dev
# Conexões do pool do Postgres.
DB_MAX_CONNECTIONS=3
# Threads do servidor HTTP. Em produção, o número de núcleos.
APP_WORKERS=1

# Montada a partir das variáveis acima; é o que o sqlx usa nas migrations e nas
# macros de compilação.
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Sessões e contador de visitas ao perfil.
REDIS_URL="redis://localhost:6379"

# Login com Google. Client id e secret saem do Google Cloud Console; a redirect
# uri precisa ser idêntica à cadastrada lá. As três últimas só mudam em teste.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8001/api/v1/auth/google/callback"
GOOGLE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
GOOGLE_TOKEN_URI="https://oauth2.googleapis.com/token"
GOOGLE_USER_INFO_URI="https://www.googleapis.com/oauth2/v1/userinfo"

# "dev" ou "prod". Em dev: rate limit permissivo, arquivos no disco em vez do
# bucket, workers de e-mail e de exclusão desligados e /api/docs no ar.
APP_ENVIRONMENT="dev"
# Domínio do cookie de sessão.
APP_DOMAIN="localhost"
# Origens liberadas no CORS, separadas por vírgula.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
# Exige SSL na conexão com o Postgres. Ligue em produção.
DB_REQUIRE_SSL=false

# SMTP de saída. O EMAIL_USERNAME também é o remetente de todo e-mail enviado:
# mandar de um endereço diferente do autenticado costuma cair em spam.
EMAIL_USERNAME='username@email.com'
EMAIL_PASSWORD='password'
EMAIL_SMTP_SERVER='smtp.email.com'
EMAIL_SMTP_PORT=587

# Onde os uploads são gravados em dev. Caminho relativo conta a partir do
# diretório de onde o binário é executado. Em produção os arquivos vão para o
# bucket e o diretório nem é criado.
APP_MEDIA_DIR="media"

# Storage de fotos e vídeos: qualquer S3 compatível (Cloudflare R2, MinIO, AWS
# S3). No R2 o endpoint é https://<account_id>.r2.cloudflarestorage.com.
# Ignorado em dev, onde os arquivos vão para o disco.
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=bucket-name
# Domínio público de leitura do bucket (no R2, o Custom Domain).
S3_PUBLIC_BASE_URL="https://cdn.example.com"
